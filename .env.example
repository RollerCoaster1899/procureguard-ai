# DeepSeek live provider (optional). Only used when explicitly selected via
# `--provider deepseek`. The benchmark is fully offline without these.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=30
DEEPSEEK_MAX_RETRIES=2

# Optional override for the MCP fixture facts file path
PROCUREGUARD_FACTS_PATH=

# Optional API provider default (scripted | deepseek)
PROCUREGUARD_PROVIDER=scripted
