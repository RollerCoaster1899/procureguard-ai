# Local secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Generated data artifacts (regenerated by scripts/reproduce.py or scripts/generate_data.py)
data/raw/
data/interim/
data/processed/*.json
data/processed/*.txt
!data/processed/.gitkeep

# Smoke artifacts are regenerable and not published.
reports_smoke/

# Lightweight verified full-run artifacts ARE published.
# Anything else generated under reports/ stays ignored.
reports/*
!reports/metrics/
!reports/metrics/*.json
!reports/tables/
!reports/tables/*.csv
!reports/tables/*.md
!reports/figures/
!reports/figures/*.png
!reports/traces/
!reports/traces/*.jsonl
!reports/final_report.md
!reports/run_config.yaml
!reports/run_metadata.json

# Logs
*.log
